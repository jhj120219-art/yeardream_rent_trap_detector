# 저장소 루트에서 실행. uvicorn --env-file 사용 시 python-dotenv 별도 설치
# MySQL 8.x (URL encode special characters in credentials)
DATABASE_URL=mysql+pymysql://rent_app:CHANGE_ME@127.0.0.1:3306/rent_app
# Legacy/test only: unset DATABASE_URL before using SQLite
# BACKEND_DB_PATH=backend/data/app.sqlite3
RENT_CLEAN_CSV=backend/data/clean_rent_data.csv
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 이미지 입력을 사용할 때만 설정. 모델은 계정에서 사용 가능한 vision/structured outputs 모델.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=

# 건물 주소 검색 API(호수 자동 확인 기능 아님)
KAKAO_REST_API_KEY=

# Optional local Docker MySQL server only; use different generated passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
